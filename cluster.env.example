# Site-specific settings for running on a Slurm cluster. Copy this file to
# cluster.env (which git ignores) and fill in your cluster's values:
#
#   cp cluster.env.example cluster.env
#
# The slurm/*.sbatch scripts read it. Your instructor or cluster admins will
# have the right values - nothing in this file is secret, it's just local.

# GPU partition to submit to (see `sinfo` for the ones you can use).
# sbatch reads SBATCH_PARTITION itself, so this needs no #SBATCH line.
export SBATCH_PARTITION=gpu

# Commands that make `python` the one with ultralytics etc. installed.
# E.g. a module + conda env, or a plain venv:
#   ENV_SETUP="module load conda/latest && conda activate /path/to/env"
#   ENV_SETUP="source ~/venvs/crabpot/bin/activate"
export ENV_SETUP="conda activate crabpot-training"

# Full path to the data.yaml written by dataset_to_yolo.py.
export DATA=/path/to/sss-crab-pot-detection-yolo/data.yaml
